# Copy to .env and fill in your own values. Do not commit .env.
MONGO_URI=mongodb://<user>:<pass>@<host>:27017/<db>

# Identifies the crawler to hosts, and is matched against robots.txt User-agent
# groups. Point the URL at something that explains the bot.
CRAWLER_USER_AGENT=webcrawler (+https://github.com/Megapixel99/webCrawler)
# Politeness floor between requests to the same host, in ms. A host's
# Crawl-delay can raise this but never lower it.
MIN_CRAWL_DELAY_MS=5000
# Ceiling, so one host advertising a huge Crawl-delay cannot stall a worker.
MAX_CRAWL_DELAY_MS=60000
REQUEST_TIMEOUT_MS=10000
